# Normalize text in Git while leaving detected binary files unchanged.
* text=auto

*.md text eol=lf
*.c text eol=lf
*.h text eol=lf
*.s text eol=lf
*.ioc text eol=lf
*.uvprojx text eol=lf
*.uvoptx text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

*.jpg binary
*.jpeg binary
*.png binary
